    clA -.->|"Argo CD pulls"| git[("Git: model catalog<br/>and platform repositories")]
    clB -.->|"Argo CD pulls"| git
    ecrA[("Registry A")] -.->|"replicate"| ecrB[("Registry B")]
    s3A[("Artefact bucket A")] -.->|"replicate"| s3B[("Artefact bucket B")]
